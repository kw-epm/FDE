# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/medflex

# Anthropic
ANTHROPIC_API_KEY=

# ServiceNow integration. Set SERVICENOW_BASE_URL=mock to use fixtures/servicenow_fixture.json.
SERVICENOW_BASE_URL=mock
SERVICENOW_OAUTH_TOKEN=
SHIFT_REQUEST_TABLE_NAME=u_shift_requests
SERVICENOW_POLL_INTERVAL_SECONDS=120
SERVICENOW_OUTAGE_PAUSE_MINUTES=15

# MedFlex hospital profile API. Set MEDFLEX_API_BASE_URL=mock to use fixtures/hospital_profiles.json.
MEDFLEX_API_BASE_URL=mock
MEDFLEX_API_KEY=

# LLM
INTAKE_LLM_MODEL=claude-haiku-4-5-20251001
INTAKE_CONFIDENCE_HIGH_THRESHOLD=0.85
INTAKE_CONFIDENCE_LOW_THRESHOLD=0.65

# Coordinator escalation
CLARIFICATION_TIMEOUT_MINUTES=60

# Ops alerting webhook (POST JSON). If unset, alerts go to stderr.
OPS_ALERT_WEBHOOK_URL=

# Cost circuit breaker
DAILY_LLM_COST_LIMIT_USD=50

# Version (logged in audit trail)
AGENT_VERSION=0.1.0
