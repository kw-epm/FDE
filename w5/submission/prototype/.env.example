# Copy to .env (or export) to enable the LIVE Haiku/Sonnet path.
# Without a key + the anthropic SDK, the prototype runs the offline deterministic mock.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults are pinned in config.py; no Opus path).
# RESOLVEONE_MODEL_CLASSIFY=claude-haiku-4-5
# RESOLVEONE_MODEL_REASON=claude-sonnet-4-6
